{
  "name": "niimblue-mcp",
  "version": "1.2.0",
  "description": "MCP server that designs NIIMBOT labels, renders the exact 1-bit print preview with NiimBlue's own code in headless Chrome, and hands them to NiimBlue as an open-in-app link.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "nightious",
  "homepage": "https://github.com/Nightious-Tools/niimblue-mcp",
  "repository": { "type": "git", "url": "git+https://github.com/Nightious-Tools/niimblue-mcp.git" },
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "claude", "claude-code", "codex", "niimbot", "niimblue", "label", "label-printer", "thermal-printer"],
  "bin": { "niimblue-mcp": "dist/index.mjs" },
  "files": ["dist", "fonts"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.page.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.mjs",
    "pack": "npm run build && npx -y @anthropic-ai/mcpb pack"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans": "5.2.10",
    "@mmote/niimbluelib": "0.47.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^22.12.0",
    "d3-dsv": "3.0.1",
    "dayjs": "1.11.21",
    "esbuild": "0.28.2",
    "fabric": "7.4.0",
    "jsqr": "1.4.0",
    "material-icons": "1.13.14",
    "niimblue": "github:MultiMote/niimblue#82c5605780818299422a6acdf3180d87c569578d",
    "pngjs": "7.0.0",
    "qrcode-generator": "2.0.4",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "fabric": { "canvas": "npm:uninstall" }
  }
}
