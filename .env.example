# ---- NiimBlue MCP ------------------------------------------------------------
# All settings are optional. No credentials; the server never prints and never
# talks to a printer, and writes files only for save_as. It renders in headless
# Chrome/Edge and returns a NiimBlue link.

# Chrome, Chromium or Edge executable. Unset: auto-detect the usual install paths.
# NIIMBLUE_CHROME=/usr/bin/google-chrome

# Base URL the label link opens (http or https; any #hash is dropped).
# Use http://localhost:4391/ for a local NiimBlue fork preview.
NIIMBLUE_APP_URL=https://niim.blue/

# Folder render_label save_as writes templates to (created on first save).
# Unset: ~/Documents/NiimBlue Templates
# NIIMBLUE_TEMPLATES_DIR=/home/me/Documents/NiimBlue Templates

# Log level: silent | error | info | debug  (logs go to stderr, never stdout)
NIIMBLUE_LOG_LEVEL=info
